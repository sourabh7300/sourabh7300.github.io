{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "aura-backend/**",
      "server.js",
      "render.yaml",
      "package.json",
      "package-lock.json",
      "README.md",
      "LICENSE.txt"
    ],
    "rewrites": [
      { "source": "/v1/**", "destination": "https://aura-backend-jomj.onrender.com/v1/$1" }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
